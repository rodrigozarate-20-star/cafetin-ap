rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = usuario cuyo UID tiene un documento en /admins/{uid}
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Carta: todos leen. Los clientes solo pueden BAJAR el stock (al pedir).
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    && request.resource.data.stock is int
                    && request.resource.data.stock >= 0
                    && request.resource.data.stock < resource.data.stock;
    }

    // Mesas: todos leen. Los clientes solo pueden pasar Libre -> Reservada.
    match /mesas/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if resource.data.estado == 'Libre'
                    && request.resource.data.estado == 'Reservada'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'reservadaPor']);
    }

    // Contador de pedidos (para el número #1, #2, ...)
    match /meta/contador {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedidos'])
                    && request.resource.data.pedidos == resource.data.pedidos + 1;
    }

    // Pedidos: el cliente crea y sigue SU pedido (conoce el ID). Solo el admin lista y cambia estados.
    match /pedidos/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                         ['numero', 'cliente', 'mesaId', 'mesaNumero', 'items', 'total', 'estado', 'fecha'])
                    && request.resource.data.estado == 'Pendiente'
                    && request.resource.data.cliente is string
                    && request.resource.data.cliente.size() > 0
                    && request.resource.data.cliente.size() <= 60
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.fecha == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
